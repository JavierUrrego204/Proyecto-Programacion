import os
import sys
import tempfile
import unittest
from unittest.mock import Mock, patch

sys.path.insert(
    0, os.path.join(os.path.dirname(_file_), "Client")
)

import virtuallab_client as vc


class TestClienteVirtualLab(unittest.TestCase):

    def setUp(self):
        self.temp = tempfile.TemporaryDirectory()
        self.directorio_original = os.getcwd()
        os.chdir(self.temp.name)

        self.url = "http://localhost:8080"
        self.respuesta = Mock()
        self.respuesta.content = b"OK"

    def tearDown(self):
        os.chdir(self.directorio_original)
        self.temp.cleanup()

    def test_registrar_usuario(self):
        with patch.object(
            vc.requests, "post", return_value=self.respuesta
        ) as post:
            resultado = vc.registerUser(
                self.url, "Ana", "100", "student", "clave123"
            )

        self.assertEqual(resultado, "OK")
        post.assert_called_once()

    def test_abrir_sesion(self):
        with patch.object(
            vc.requests, "post", return_value=self.respuesta
        ) as post:
            resultado = vc.openSession(
                self.url, "100", "clave123"
            )

        self.assertEqual(resultado, "OK")
        post.assert_called_once()

    def test_cerrar_sesion(self):
        with patch.object(
            vc.requests, "post", return_value=self.respuesta
        ) as post:
            resultado = vc.closeSession(self.url, "100")

        self.assertEqual(resultado, "OK")
        post.assert_called_once()

    def test_subir_laboratorio(self):
        ruta = os.path.join(self.temp.name, "lab.zip")

        with open(ruta, "wb") as archivo:
            archivo.write(b"contenido de prueba")

        with patch.object(
            vc.requests, "post", return_value=self.respuesta
        ) as post:
            resultado = vc.uploadLab(self.url, "100", ruta)

        self.assertEqual(resultado, "OK")
        post.assert_called_once()

    def test_descargar_laboratorio(self):
        self.respuesta.content = b"contenido ZIP"

        with patch.object(
            vc.requests, "get", return_value=self.respuesta
        ):
            resultado = vc.downloadLab(
                self.url, "200", "lab.zip"
            )

        ruta = os.path.join("client", "labs", "lab.zip")

        self.assertTrue(os.path.exists(ruta))
        with open(ruta, "rb") as archivo:
            self.assertEqual(archivo.read(), b"contenido ZIP")

        self.assertIn("lab.zip", resultado)

    def test_listar_laboratorios_estudiante(self):
        with patch.object(
            vc.requests, "get", return_value=self.respuesta
        ) as get:
            resultado = vc.listStudentLabs(self.url, "200")

        self.assertEqual(resultado, "OK")
        get.assert_called_once()

    def test_listar_laboratorios_profesor(self):
        with patch.object(
            vc.requests, "get", return_value=self.respuesta
        ) as get:
            resultado = vc.listProfessorsLabs(
                self.url, "100"
            )

        self.assertEqual(resultado, "OK")
        get.assert_called_once()

    def test_listar_estudiantes(self):
        with patch.object(
            vc.requests, "get", return_value=self.respuesta
        ) as get:
            resultado = vc.listStudents(self.url, "100")

        self.assertEqual(resultado, "OK")
        get.assert_called_once()

    def test_asignar_laboratorio(self):
        with patch.object(
            vc.requests, "post", return_value=self.respuesta
        ) as post:
            resultado = vc.assignLab(
                self.url, "100", "lab", "200"
            )

        self.assertEqual(resultado, "OK")
        post.assert_called_once()


if _name_ == "_main_":
    unittest.main(verbosity=2)
