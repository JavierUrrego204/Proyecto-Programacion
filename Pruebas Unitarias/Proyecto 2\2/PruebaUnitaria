class TestSpiceSimulation(unittest.TestCase):
    def make_student(self, lines=None):
        student = app.StudentView.__new__(app.StudentView)
        student._StudentView__current_netlist_lines = (
            lines if lines is not None else ["Circuito", ".end"]
        )
        student._StudentView__node_voltages = {}
        student.console = []
        student.write_console = lambda text, clear=False: student.console.append((text, clear))
        student.draw_count = 0
        student._draw_circuit_schematic = lambda: setattr(student, "draw_count", student.draw_count + 1)
        return student

    def fake_pyspice(self, parser):
        root = types.ModuleType("PySpice")
        root.__path__ = []
        spice = types.ModuleType("PySpice.Spice")
        spice.__path__ = []
        parser_module = types.ModuleType("PySpice.Spice.Parser")
        parser_module.SpiceParser = parser
        return {"PySpice": root, "PySpice.Spice": spice, "PySpice.Spice.Parser": parser_module}

    def test_simulation_stores_operating_point_voltages_and_redraws(self):
        circuit = types.SimpleNamespace(
            title="Circuito", simulator=lambda **kwargs: types.SimpleNamespace(
                operating_point=lambda: types.SimpleNamespace(nodes={"out": [5.0], "0": [0.0]})
            )
        )
        parser = lambda **kwargs: types.SimpleNamespace(build_circuit=lambda: circuit)
        student = self.make_student()
        with patch.dict(sys.modules, self.fake_pyspice(parser)):
            app.StudentView._execute_loaded_netlist(student, "prueba.zip")
        self.assertEqual(student._StudentView__node_voltages, {"out": 5.0, "0": 0.0})
        self.assertEqual(student.draw_count, 1)
        self.assertTrue(any("Simulación completada" in row[0] for row in student.console))

    def test_simulation_uses_ngspice_output_when_operating_point_fails(self):
        commands = []
        ngspice = types.SimpleNamespace(
            clear_output=lambda: None,
            exec_command=commands.append,
            stdout="v(out) = 1.25\nv(in) = 2.5\ni1#branch = 0.1\n",
            stderr="",
        )
        simulator = types.SimpleNamespace(
            operating_point=lambda: (_ for _ in ()).throw(RuntimeError("wrapper error")),
            ngspice=ngspice,
        )
        circuit = types.SimpleNamespace(title="Circuito", simulator=lambda **kwargs: simulator)
        parser = lambda **kwargs: types.SimpleNamespace(build_circuit=lambda: circuit)
        student = self.make_student()
        with patch.dict(sys.modules, self.fake_pyspice(parser)):
            app.StudentView._execute_loaded_netlist(student, "prueba.zip")
        self.assertEqual(student._StudentView__node_voltages, {"out": 1.25, "in": 2.5})
        self.assertEqual(commands, ["op", "print all"])

    def test_simulation_reports_parser_errors_without_raising(self):
        parser = lambda **kwargs: types.SimpleNamespace(
            build_circuit=lambda: (_ for _ in ()).throw(ValueError("netlist inválido"))
        )
        student = self.make_student()
        with patch.dict(sys.modules, self.fake_pyspice(parser)), \
                patch.object(app.messagebox, "showerror") as showerror:
            app.StudentView._execute_loaded_netlist(student, "prueba.zip")
        showerror.assert_called_once()
        self.assertTrue(any("netlist inválido" in row[0] for row in student.console))

    def test_simulation_does_nothing_when_no_netlist_is_loaded(self):
        student = self.make_student([])
        with patch.object(app.messagebox, "showerror") as showerror:
            app.StudentView._execute_loaded_netlist(student, "vacío")
        showerror.assert_not_called()
        self.assertEqual(student.console, [])

    def test_zip_simulation_extracts_cir_and_parses_components(self):
        with tempfile.TemporaryDirectory() as folder:
            old_cwd = os.getcwd()
            os.chdir(folder)
            try:
