            ("99", "Servidor", "Clase B", "Estudiante"),
            ("88", "Local", "Clase A", "Estudiante"),
        ])


class TestAsyncErrorCallbacks(unittest.TestCase):
    class ImmediateThread:
        def __init__(self, target, daemon=True):
            self.target = target

        def start(self):
            self.target()

    def queue_failing_task_callback(self, on_error):
        callbacks = []
        fake_app = types.SimpleNamespace(
            winfo_exists=lambda: True,
            after=lambda delay, callback: callbacks.append(callback),
        )

        def fail():
            raise RuntimeError("servidor no disponible")

        with patch.object(app.threading, "Thread", self.ImmediateThread):
            app.VirtualLab._run_async(fake_app, fail, lambda result: None, on_error)
        self.assertEqual(len(callbacks), 1)
        return callbacks[0]

    def test_error_callback_keeps_exception_after_worker_finishes(self):
        errors = []
        callback = self.queue_failing_task_callback(errors.append)
        callback()
        self.assertEqual(len(errors), 1)
        self.assertIsInstance(errors[0], RuntimeError)
        self.assertEqual(str(errors[0]), "servidor no disponible")

    def test_default_error_dialog_keeps_exception_after_worker_finishes(self):
        callback = self.queue_failing_task_callback(None)
        with patch.object(app.messagebox, "showerror") as showerror:
            callback()
        showerror.assert_called_once_with("Error de conexión", "servidor no disponible")


class TestSafeCall(unittest.TestCase):
