class TestClientCompatibilityAdapters(unittest.TestCase):
    def setUp(self):
        self.fake_app = types.SimpleNamespace(app=types.SimpleNamespace(user_id=77))
        self.temp_folder = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp_folder.cleanup)
        self.source_zip = Path(self.temp_folder.name) / "source.zip"
        with zipfile.ZipFile(self.source_zip, "w") as archive:
            archive.writestr("circuito.cir", "Circuito\n.end\n")

    def test_list_students_supports_url_and_user_id(self):
        calls = []
        def list_students(url, uid):
            calls.append((url, uid))
            return ["student"]
        with patch.object(app, "client", types.SimpleNamespace(listStudents=list_students)):
            result = app.ProfessorView._api_list_students(self.fake_app, 12)
        self.assertEqual(result, ["student"])
        self.assertEqual(calls, [(app.URL, 12)])

    def test_list_students_supports_url_only_signature(self):
        calls = []
        def list_students(url):
            calls.append((url,))
            return []
        with patch.object(app, "client", types.SimpleNamespace(listStudents=list_students)):
            app.ProfessorView._api_list_students(self.fake_app)
        self.assertEqual(calls, [(app.URL,)])

    def test_list_students_without_client_method_returns_empty_list(self):
        with patch.object(app, "client", types.SimpleNamespace()):
            self.assertEqual(app.ProfessorView._api_list_students(self.fake_app), [])

    def test_upload_lab_supports_four_argument_signature(self):
        calls = []
        def upload(url, uid, name, path):
            calls.append((url, uid, name, zipfile.is_zipfile(path)))
            return "ok"
        with patch.object(app, "client", types.SimpleNamespace(uploadLab=upload)):
            result = app.ProfessorView._api_upload_lab(self.fake_app, "A.zip", str(self.source_zip))
        self.assertEqual(result, "ok")
        self.assertEqual(calls, [(app.URL, 77, "A.zip", True)])

    def test_upload_lab_supports_legacy_three_argument_signature(self):
        calls = []
        def upload(url, uid, path):
            calls.append((url, uid, zipfile.is_zipfile(path)))
            return "ok"
        with patch.object(app, "client", types.SimpleNamespace(uploadLab=upload)):
            app.ProfessorView._api_upload_lab(self.fake_app, "A.zip", str(self.source_zip))
        self.assertEqual(calls, [(app.URL, 77, True)])

    def test_upload_lab_supports_file_before_name_signature(self):
        calls = []
        def upload(url, uid, file_path, lab_name):
            calls.append((url, uid, zipfile.is_zipfile(file_path), lab_name))
            return "ok"
        with patch.object(app, "client", types.SimpleNamespace(uploadLab=upload)):
            result = app.ProfessorView._api_upload_lab(self.fake_app, "A.zip", str(self.source_zip))
        self.assertEqual(result, "ok")
        self.assertEqual(calls, [(app.URL, 77, True, "A.zip")])

    def test_assign_lab_places_lab_before_student_when_signature_says_so(self):
        calls = []
        def assign(url, uid, lab_name, student_id):
            calls.append((url, uid, lab_name, student_id))
        with patch.object(app, "client", types.SimpleNamespace(assignLab=assign)):
            app.ProfessorView._api_assign_lab(self.fake_app, 12, "A.zip")
        self.assertEqual(calls, [(app.URL, 77, "A.zip", 12)])

    def test_assign_lab_places_student_before_lab_when_signature_says_so(self):
        calls = []
        def assign(url, uid, student_id, lab_name):
            calls.append((url, uid, student_id, lab_name))
        with patch.object(app, "client", types.SimpleNamespace(assignLab=assign)):
            app.ProfessorView._api_assign_lab(self.fake_app, 12, "A.zip")
        self.assertEqual(calls, [(app.URL, 77, 12, "A.zip")])

    def test_assign_lab_supports_three_argument_legacy_signature(self):
        calls = []
        def assign(url, lab_name, student_id):
            calls.append((url, lab_name, student_id))
        with patch.object(app, "client", types.SimpleNamespace(assignLab=assign)):
            app.ProfessorView._api_assign_lab(self.fake_app, 12, "A.zip")
        self.assertEqual(calls, [(app.URL, "A.zip", 12)])


class TestLocalRoster(unittest.TestCase):
    def make_context(self, path, user_id=77):
        context = app.ProfessorView.__new__(app.ProfessorView)
        context.app = types.SimpleNamespace(user_id=user_id)
        context._ProfessorView__prof_users = [("old", "Old", "Old class", "Estudiante")]
        context._ProfessorView__prof_classes = ["Old class"]
        context._ProfessorView__removed_students = {"old"}
        context._roster_file = lambda: str(path)
        return context

    def test_missing_roster_resets_local_state(self):
        with tempfile.TemporaryDirectory() as folder:
            context = self.make_context(Path(folder) / "missing.json")
            app.ProfessorView._load_local_roster(context)
        self.assertEqual(context.prof_users, [])
        self.assertEqual(context.prof_classes, ["Sin clase"])
        self.assertEqual(context._ProfessorView__removed_students, set())

    def test_loads_classes_and_legacy_user_rows(self):
        with tempfile.TemporaryDirectory() as folder:
            path = Path(folder) / "roster.json"
            path.write_text(json.dumps({
                "classes": [" Física ", "", "Física"],
                "users": [
                    ["7", "Ana", "Física", "Estudiante"],
                    ["8", "Luis", "Profesor"],
                    ["malformado"],
                ],
                "removed": ["9", "ana"],
            }), encoding="utf-8")
            context = self.make_context(path)
            app.ProfessorView._load_local_roster(context)
        self.assertEqual(context.prof_classes, ["Sin clase", "Física"])
        self.assertEqual(context.prof_users, [
            ("7", "Ana", "Física", "Estudiante"),
            ("8", "Luis", "Sin clase", "Profesor"),
        ])
        self.assertEqual(context._ProfessorView__removed_students, {"9", "ana"})

    def test_corrupt_roster_resets_state_without_raising(self):
        with tempfile.TemporaryDirectory() as folder:
            path = Path(folder) / "roster.json"
            path.write_text("{no es json", encoding="utf-8")
            context = self.make_context(path)
            app.ProfessorView._load_local_roster(context)
        self.assertEqual(context.prof_users, [])
        self.assertEqual(context.prof_classes, ["Sin clase"])
        self.assertEqual(context._ProfessorView__removed_students, set())

    def test_save_and_reload_preserves_classes_users_and_removals(self):
        with tempfile.TemporaryDirectory() as folder:
            path = Path(folder) / "roster.json"
            saved = app.ProfessorView.__new__(app.ProfessorView)
            saved.app = types.SimpleNamespace(user_id=77)
            saved._ProfessorView__prof_classes = ["Sin clase", "Electrónica"]
            saved._ProfessorView__prof_users = [("23", "Ángela", "Electrónica", "Estudiante")]
            saved._ProfessorView__removed_students = {"11"}
            saved._roster_file = lambda: str(path)
            app.ProfessorView._save_local_roster(saved)
            loaded = self.make_context(path)
            app.ProfessorView._load_local_roster(loaded)
        self.assertEqual(loaded.prof_classes, ["Sin clase", "Electrónica"])
        self.assertEqual(loaded.prof_users, [("23", "Ángela", "Electrónica", "Estudiante")])
        self.assertEqual(loaded._ProfessorView__removed_students, {"11"})

    def test_save_skips_when_professor_id_is_missing(self):
        with tempfile.TemporaryDirectory() as folder:
            path = Path(folder) / "should-not-exist.json"
            context = types.SimpleNamespace(
                app=types.SimpleNamespace(user_id=None),
                _roster_file=lambda: self.fail("No debe calcular la ruta sin ID"),
            )
            app.ProfessorView._save_local_roster(context)
            self.assertFalse(path.exists())


class TestStudentVerification(unittest.TestCase):
    def make_context(self, server_response, local_users=None, teacher_id=900):
        context = app.ProfessorView.__new__(app.ProfessorView)
        context.app = types.SimpleNamespace(user_id=teacher_id)
        context._ProfessorView__prof_users = local_users or []
        context._api_list_students = lambda uid: server_response
        return context

    def test_rejects_professors_own_id_without_server_call(self):
        calls = []
        context = self.make_context(None)
        context._api_list_students = lambda uid: calls.append(uid)
        valid, message = app.ProfessorView._verify_student_exists(context, 900, "Ana")
        self.assertFalse(valid)
        self.assertIn("pertenece a tu cuenta", message)
        self.assertEqual(calls, [])

    def test_rejects_local_id_already_assigned_to_another_name(self):
        calls = []
        context = self.make_context(None, [("123", "Ana", "Física", "Estudiante")])
        context._api_list_students = lambda uid: calls.append(uid)
        valid, message = app.ProfessorView._verify_student_exists(context, 123, "Luis")
        self.assertFalse(valid)
        self.assertIn("ya está asignado", message)
        self.assertEqual(calls, [])

    def test_accepts_matching_server_id_and_name(self):
        context = self.make_context({"students": [{"id": 123, "name": "Ana"}]})
        self.assertEqual(app.ProfessorView._verify_student_exists(context, 123, " Ana "), (True, "OK"))

    def test_rejects_id_not_registered_on_server(self):
        context = self.make_context({"students": [{"id": 123, "name": "Ana"}]})
        valid, message = app.ProfessorView._verify_student_exists(context, 124, "Luis")
        self.assertFalse(valid)
        self.assertIn("no existe", message)

    def test_rejects_name_that_does_not_match_server_id(self):
        context = self.make_context({"students": [{"id": 123, "name": "Ana"}]})
        valid, message = app.ProfessorView._verify_student_exists(context, 123, "Luis")
        self.assertFalse(valid)
        self.assertIn("pertenece a 'Ana'", message)

    def test_accepts_matching_name_when_server_has_no_ids(self):
        context = self.make_context(["Ana", "Luis"])
        self.assertEqual(app.ProfessorView._verify_student_exists(context, 123, "ana"), (True, "OK"))

    def test_rejects_unregistered_name_when_server_has_no_ids(self):
        context = self.make_context(["Ana", "Luis"])
        valid, message = app.ProfessorView._verify_student_exists(context, 123, "Mara")
        self.assertFalse(valid)
        self.assertIn("no está registrado", message)

    def test_empty_server_list_allows_local_fallback(self):
        self.assertEqual(
            app.ProfessorView._verify_student_exists(self.make_context([]), 123, "Mara"),
            (True, "OK"),
        )


class TestServerStudentMerge(unittest.TestCase):
    def make_context(self, local_users, removed=None):
        saves = []
        context = app.ProfessorView.__new__(app.ProfessorView)
        context._ProfessorView__prof_users = list(local_users)
        context._ProfessorView__removed_students = set(removed or [])
        context._save_local_roster = lambda: saves.append(True)
