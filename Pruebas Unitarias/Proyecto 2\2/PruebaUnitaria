class TestSpiceNetlist(unittest.TestCase):
    def make_student(self):
        return app.StudentView.__new__(app.StudentView)

    def test_parses_supported_components_and_preserves_extra_parameters(self):
        lines = [
            "Title", "* comment", ".op", "R1 in out 10k temp=25",
            "V1 out 0 5", "C1 out 0 10u IC=0", "L1 out gnd 2m",
            "D1 out n2 Dmodel area=2", "Q1 a b c model", "R2 too-short",
        ]
        actual = app.StudentView._parse_spice_components(self.make_student(), lines)
        self.assertEqual([item["type"] for item in actual], ["R", "V", "C", "L", "D"])
        self.assertEqual(actual[0]["extra"], "temp=25")
        self.assertEqual(actual[-1]["value"], "Dmodel")
        self.assertEqual(actual[-1]["extra"], "area=2")
        self.assertEqual(actual[0]["line_idx"], 3)

    def test_parser_returns_empty_for_comments_directives_and_incomplete_lines(self):
        actual = app.StudentView._parse_spice_components(
            self.make_student(), ["", "* comment", ".tran 1u 5m", "+ continuation", "R1 n1"]
        )
        self.assertEqual(actual, [])

    def test_node_voltage_lookup_ignores_case_and_whitespace(self):
        student = self.make_student()
        student._StudentView__node_voltages = {" Out ": 3.3, "in": 1.2}
