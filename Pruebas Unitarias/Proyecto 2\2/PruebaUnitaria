class TestRegistration(unittest.TestCase):
    def make_context(self, name="Ana Pérez", user_id="123", role="Profesor", password="clave"):
        calls = {}
        context = types.SimpleNamespace(
            reg_name=FakeEntryValue(name),
            reg_id=FakeEntryValue(user_id),
            reg_role=FakeEntryValue(role),
            reg_password=FakeEntryValue(password),
            reg_btn=FakeButtonState(),
            _run_async=lambda task, done, error: calls.update(task=task, done=done, error=error),
            show_login=lambda: calls.update(show_login=True),
        )
        return context, calls

    def test_register_rejects_missing_fields(self):
        context, calls = self.make_context(name="")
        with patch.object(app.messagebox, "showwarning") as warning:
            app.VirtualLab.register(context)
        warning.assert_called_once()
        self.assertNotIn("task", calls)

    def test_register_rejects_non_numeric_id(self):
        context, calls = self.make_context(user_id="12a")
        with patch.object(app.messagebox, "showwarning") as warning:
            app.VirtualLab.register(context)
        warning.assert_called_once_with("ID inválido", unittest.mock.ANY)
        self.assertNotIn("task", calls)

    def test_register_translates_professor_role_and_trims_fields(self):
        context, calls = self.make_context(name=" Ana Pérez ", user_id="00123", password=" clave ")
        sent = []
        with patch.object(app, "client", types.SimpleNamespace(
                registerUser=lambda *args: sent.append(args) or "created")), patch.object(app, "URL", "http://lab"):
            app.VirtualLab.register(context)
            result = calls["task"]()
        self.assertEqual(result, "created")
        self.assertEqual(sent, [("http://lab", "Ana Pérez", 123, "professor", " clave ")])
        self.assertEqual(context.reg_btn.state, "disabled")
        self.assertEqual(context.reg_btn.text, "Registrando...")

    def test_successful_registration_restores_button_and_returns_to_login(self):
        context, calls = self.make_context()
        with patch.object(app.messagebox, "showinfo") as showinfo:
            app.VirtualLab.register(context)
            calls["done"]("created")
        self.assertEqual(context.reg_btn.state, "normal")
        self.assertEqual(context.reg_btn.text, "Registrarse")
        self.assertTrue(calls.get("show_login"))
        showinfo.assert_called_once()

    def test_duplicate_registration_shows_warning_and_stays_on_form(self):
        context, calls = self.make_context()
        with patch.object(app.messagebox, "showwarning") as warning:
            app.VirtualLab.register(context)
            calls["done"]("already registered")
        warning.assert_called_once()
        self.assertNotIn("show_login", calls)

    def test_server_error_shows_error_and_stays_on_form(self):
        context, calls = self.make_context()
        with patch.object(app.messagebox, "showerror") as showerror:
            app.VirtualLab.register(context)
            calls["done"]("error: unavailable")
        showerror.assert_called_once()
        self.assertNotIn("show_login", calls)

    def test_async_registration_error_restores_button(self):
        context, calls = self.make_context()
        with patch.object(app.messagebox, "showerror") as showerror:
            app.VirtualLab.register(context)
            calls["error"](RuntimeError("sin conexión"))
        self.assertEqual(context.reg_btn.state, "normal")
        self.assertEqual(context.reg_btn.text, "Registrarse")
        showerror.assert_called_once_with("Error de registro", "sin conexión")


