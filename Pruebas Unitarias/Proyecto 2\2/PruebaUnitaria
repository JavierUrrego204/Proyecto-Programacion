class FakeTree:
    def __init__(self):
        self.rows = []

    def get_children(self):
        return list(range(len(self.rows)))

    def delete(self, item):
        self.rows.pop(item)

    def insert(self, parent, index, values):
        self.rows.append(tuple(values))


