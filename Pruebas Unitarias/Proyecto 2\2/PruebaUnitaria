class TestServerConfiguration(unittest.TestCase):
    def setUp(self):
        self.fake_app = app.VirtualLab.__new__(app.VirtualLab)
        self.temp_folder = tempfile.TemporaryDirectory()
        self.addCleanup(self.temp_folder.cleanup)
        self.old_cwd = os.getcwd()
        os.chdir(self.temp_folder.name)
        self.addCleanup(os.chdir, self.old_cwd)
        self.config = Path(self.temp_folder.name) / "client" / "server_config.json"
        self.config.parent.mkdir()
        self.config_patch = patch.object(app, "SERVER_CONFIG_FILE", str(self.config))
        self.config_patch.start()
        self.addCleanup(self.config_patch.stop)

    def test_adds_protocol_and_default_port_to_bare_host(self):
        with patch.object(app, "URL", "http://old"):
            result = app.VirtualLab._apply_server_url(self.fake_app, "  192.168.1.25/  ")
        self.assertEqual(result, "http://192.168.1.25:80")

    def test_keeps_explicit_https_port_and_path(self):
        with patch.object(app, "URL", "http://old"):
            result = app.VirtualLab._apply_server_url(self.fake_app, " https://lab.example:8443/api/ ")
        self.assertEqual(result, "https://lab.example:8443/api")

    def test_empty_value_uses_localhost_and_writes_config(self):
        with patch.object(app, "URL", "http://old"):
            result = app.VirtualLab._apply_server_url(self.fake_app, "  ")
        self.assertEqual(result, "http://127.0.0.1:80")
