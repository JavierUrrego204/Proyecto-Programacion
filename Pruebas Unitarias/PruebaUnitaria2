import os
import sys
import json
import tempfile
import unittest

# Permite importar funcionescomp.py desde la carpeta principal.
sys.path.insert(0, os.path.dirname(os.path.abspath(_file_)))

import funcionescomp as fc


class TestVirtualLab(unittest.TestCase):

    def setUp(self):
        # Cada prueba utiliza archivos temporales independientes.
        self.temp = tempfile.TemporaryDirectory()
        self.directorio_original = os.getcwd()
        os.chdir(self.temp.name)

        os.makedirs("server/labs", exist_ok=True)

        # Guardar las rutas originales para restaurarlas al terminar.
        self.rutas_originales = {
            "usersFile": fc.usersFile,
            "sessionsFile": fc.sessionsFile,
            "assignmentsFile": fc.assignmentsFile,
        }

        fc.usersFile = "server/users.txt"
        fc.sessionsFile = "server/sessions.txt"
        fc.assignmentsFile = "server/assignments.txt"

        fc.registerUser("Profesor", "100", "professor", "pro123")
        fc.registerUser("Estudiante", "200", "student", "est123")

    def tearDown(self):
        for atributo, ruta in self.rutas_originales.items():
            setattr(fc, atributo, ruta)

        os.chdir(self.directorio_original)
        self.temp.cleanup()

    def login_profesor(self):
        return fc.openSession("100", "pro123")

    def login_estudiante(self):
        return fc.openSession("200", "est123")

    def crear_laboratorio(self, nombre="prueba"):
        ruta = f"server/labs/{nombre}.zip"
        with open(ruta, "wb") as archivo:
            archivo.write(b"contenido de prueba")
        return ruta

    def asignar_laboratorio(self, nombre="prueba"):
        self.login_profesor()
        self.crear_laboratorio(nombre)
        return fc.assignLab("100", nombre, "200")

    # 1. REGISTRO

    def test_registrar_usuario_nuevo(self):
        resultado = fc.registerUser(
            "Ana", "300", "student", "ana123"
        )
        self.assertEqual(
            resultado, "User Ana with role student registered"
        )

    def test_rechazar_usuario_duplicado(self):
        resultado = fc.registerUser(
            "Otro", "100", "student", "otra123"
        )
        self.assertEqual(resultado, "User already registered")

    # 2. INICIO DE SESIÓN

    def test_login_correcto(self):
        self.assertEqual(
            self.login_profesor(),
            "Session was succesfully opened"
        )

    def test_login_contrasena_incorrecta(self):
        self.assertEqual(fc.openSession("100", "mal"), "error")

    def test_login_usuario_inexistente(self):
        self.assertEqual(fc.openSession("999", "clave"), "error")

    # 3. CIERRE DE SESIÓN

    def test_cerrar_sesion_abierta(self):
        self.login_profesor()
        self.assertEqual(
            fc.closeSession("100"),
            "Session was succesfully closed"
        )

    def test_cerrar_sesion_inexistente(self):
        resultado = fc.closeSession("99999")
        self.assertEqual(resultado, "error")

    # 4. SUBIR LABORATORIOS

    def test_profesor_autenticado_puede_subir(self):
        self.login_profesor()
        resultado = fc.uploadLab(
            "100", "nuevo.zip", b"contenido"
        )
        self.assertEqual(resultado, "File was succesfully received")
        self.assertTrue(os.path.exists("server/labs/nuevo.zip"))

    def test_profesor_sin_sesion_no_puede_subir(self):
        self.assertEqual(
            fc.uploadLab("100", "nuevo.zip", b"contenido"),
            "error"
        )

    def test_estudiante_no_puede_subir(self):
        self.login_estudiante()
        self.assertEqual(
            fc.uploadLab("200", "nuevo.zip", b"contenido"),
            "error"
        )

    # 5. DESCARGAR LABORATORIOS

    def test_estudiante_puede_descargar_laboratorio_asignado(self):
        self.asignar_laboratorio()
        self.login_estudiante()

        resultado = fc.downloadLab("200", "prueba.zip")
        self.assertEqual(resultado, b"contenido de prueba")

    def test_no_descargar_laboratorio_no_asignado(self):
        self.crear_laboratorio("otro")
        self.login_estudiante()

        self.assertEqual(fc.downloadLab("200", "otro.zip"), "error")

    def test_no_descargar_sin_sesion(self):
        self.asignar_laboratorio()
        self.assertEqual(fc.downloadLab("200", "prueba.zip"), "error")

    def test_no_descargar_archivo_inexistente(self):
        self.login_profesor()
        # Se crea una asignación válida aunque el archivo no exista.
        with open(fc.assignmentsFile, "a", encoding="utf-8") as archivo:
            archivo.write(json.dumps({
                "professor_id": "100",
                "student_id": "200",
                "lab_name": "ausente"
            }) + "\n")

        self.login_estudiante()
        self.assertEqual(fc.downloadLab("200", "ausente.zip"), "error")

    # 6. LISTAR LABORATORIOS DEL ESTUDIANTE

    def test_estudiante_lista_sus_laboratorios(self):
        self.asignar_laboratorio()
        self.login_estudiante()

        resultado = fc.listStudentLabs("200")
        self.assertEqual(json.loads(resultado), ["prueba"])

    def test_estudiante_no_lista_sin_sesion(self):
        self.assertEqual(fc.listStudentLabs("200"), "error")

    def test_profesor_no_usa_listado_de_estudiante(self):
        self.login_profesor()
        self.assertEqual(fc.listStudentLabs("100"), "error")

    # 7. LISTAR LABORATORIOS DEL PROFESOR

    def test_profesor_lista_laboratorios(self):
        self.login_profesor()
        self.crear_laboratorio("prueba")

        resultado = fc.listProfessorsLabs("100")
        self.assertIn("prueba.zip", resultado)

    def test_profesor_no_lista_sin_sesion(self):
        self.assertEqual(fc.listProfessorsLabs("100"), "error")

    def test_estudiante_no_lista_laboratorios_de_profesor(self):
        self.login_estudiante()
        self.assertEqual(fc.listProfessorsLabs("200"), "error")

    # 8. LISTAR ESTUDIANTES

    def test_profesor_lista_estudiantes(self):
        self.login_profesor()
        self.assertEqual(fc.listStudents("100"), ["Estudiante"])

    def test_estudiante_no_puede_listar_estudiantes(self):
        self.login_estudiante()
        self.assertEqual(fc.listStudents("200"), "error")

    def test_profesor_no_lista_estudiantes_sin_sesion(self):
        self.assertEqual(fc.listStudents("100"), "error")

    # 9. ASIGNAR LABORATORIOS

    def test_asignacion_correcta(self):
        self.login_profesor()
        self.crear_laboratorio("prueba")

        resultado = fc.assignLab("100", "prueba", "200")
        self.assertEqual(
            resultado, "Lab prueba assigned to student 200"
        )

    def test_no_asignar_a_estudiante_inexistente(self):
        self.login_profesor()
        self.crear_laboratorio("prueba")

        self.assertEqual(
            fc.assignLab("100", "prueba", "999"), "error"
        )

    def test_no_asignar_laboratorio_inexistente(self):
        self.login_profesor()
        self.assertEqual(
            fc.assignLab("100", "ausente", "200"), "error"
        )

    def test_estudiante_no_puede_asignar(self):
        self.login_estudiante()
        self.crear_laboratorio("prueba")

        self.assertEqual(
            fc.assignLab("200", "prueba", "200"), "error"
        )

    def test_profesor_no_asigna_sin_sesion(self):
        self.crear_laboratorio("prueba")
        self.assertEqual(
            fc.assignLab("100", "prueba", "200"), "error"
        )


if _name_ == "_main_":
    unittest.main(verbosity=2)
